{
  "name": "legal-saas",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de captación de leads para despachos jurídicos premium en Meta (FB+IG).",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@legal-saas/web",
    "dev:api": "turbo run dev --filter=@legal-saas/api",
    "dev:ai": "pnpm --filter=@legal-saas/ai dev",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@legal-saas/api",
    "lint": "turbo run lint",
    "lint:api": "turbo run lint --filter=@legal-saas/api",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:api": "turbo run test --filter=@legal-saas/api",
    "test:api:e2e": "pnpm --filter=@legal-saas/api test:e2e",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "db:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "db:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "db:migrate": "pnpm --filter=@legal-saas/api db:migrate",
    "db:migrate:create": "pnpm --filter=@legal-saas/api exec prisma migrate dev --create-only",
    "db:migrate:deploy": "pnpm --filter=@legal-saas/api db:deploy",
    "db:studio": "pnpm --filter=@legal-saas/api db:studio",
    "db:seed": "pnpm --filter=@legal-saas/api db:seed",
    "db:reset": "pnpm --filter=@legal-saas/api exec prisma migrate reset",
    "db:generate": "pnpm --filter=@legal-saas/api db:generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "prettier": "^3.3.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["prettier --write"],
    "*.{md,json,yml,yaml}": ["prettier --write"]
  },
  "pnpm": {
    "overrides": {
      "fastify": "^4.29.1"
    }
  }
}
