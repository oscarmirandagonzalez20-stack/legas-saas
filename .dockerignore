# Dependencies — reinstalled inside Docker
node_modules
**/node_modules

# Build outputs — rebuilt inside Docker
dist
**/dist
.next
**/.next

# Turbo cache
.turbo
**/.turbo

# Test artifacts
coverage
**/coverage
playwright-report
test-results

# Dev environment files — never bake secrets into images
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# IDE and OS noise
.DS_Store
**/.DS_Store
.idea
.vscode
*.log

# Git history
.git
.gitignore
.gitattributes

# CI configs
.github

# TypeScript build info — rebuilt inside Docker
*.tsbuildinfo
**/*.tsbuildinfo

# pnpm local store
.pnpm-store

# Python / AI app — not needed for API image
apps/ai
apps/web

# Terraform — not needed at runtime
infra/terraform

# Docs
docs
