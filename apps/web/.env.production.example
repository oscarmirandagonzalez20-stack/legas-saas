# ── Legal SaaS Web — Production Environment Template ─────────────────────────
# For Vercel: set these in the Vercel project dashboard → Settings → Environment Variables.
# For other hosting: set in your deployment platform's secret manager.
# NEVER commit actual values to the repository.

# ── API ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# https://dashboard.clerk.com → Your App → API Keys
# Leave empty to use dev bypass mode (development only — NEVER in production).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# Required for server-side Clerk operations (auth() in server components and middleware).
CLERK_SECRET_KEY=sk_live_...

# ── Sentry (optional but strongly recommended) ────────────────────────────────
# Public DSN used on the client side (safe to expose in browser)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# Server-side DSN (can be the same as client, but kept separate for clarity)
SENTRY_DSN=https://...@sentry.io/...
# Labels errors by environment in the Sentry dashboard
NEXT_PUBLIC_APP_ENV=production
APP_ENV=production
# Only needed if uploading source maps during Vercel deploy:
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=legal-saas-web

# ── Dev bypass (MUST be empty in production) ──────────────────────────────────
# These only apply when NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is absent.
# Setting them in production with real Clerk keys active has no effect.
NEXT_PUBLIC_DEV_ORG_ID=
NEXT_PUBLIC_DEV_USER_ID=
