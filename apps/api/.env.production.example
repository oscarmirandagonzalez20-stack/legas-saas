# ── Legal SaaS API — Production Environment Template ─────────────────────────
# Copy this as a reference when configuring Railway Variables.
# NEVER commit actual values to the repository.
# Source of truth: Railway project dashboard → Variables tab.
#
# REQUIRED (app crashes on startup if missing or invalid format):
#   DATABASE_URL, REDIS_URL
#
# OPTIONAL (app boots and passes /health even when absent):
#   Everything else.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
# PORT is set automatically by Railway — do NOT override it in the dashboard.
LOG_LEVEL=info

# ── Database — Railway managed Postgres ───────────────────────────────────────
# Add a Postgres plugin in Railway → it auto-injects DATABASE_URL.
# Value must start with postgresql:// or postgres://
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# ── Redis — Railway managed Redis ─────────────────────────────────────────────
# Add a Redis plugin in Railway → it auto-injects REDIS_URL.
# Use rediss:// (double-s) for TLS connections.
REDIS_URL=rediss://:password@host:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL. Railway healthcheck does NOT need this.
FRONTEND_URL=https://app.yourdomain.com
# Optional: additional origins (comma-separated). Defaults to FRONTEND_URL.
# CORS_ORIGINS=https://app.yourdomain.com,https://staging.yourdomain.com

# ── Meta (Facebook Developer Portal) ─────────────────────────────────────────
# https://developers.facebook.com → Your App → Settings → Basic
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Choose a secure random value: openssl rand -hex 32
META_VERIFY_TOKEN=your_webhook_verify_token
# Must match exactly what you configure in Meta webhook settings
META_REDIRECT_URI=https://api.yourdomain.com/meta/oauth/callback

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting Meta access tokens at rest.
# Generate with: openssl rand -hex 32
# CRITICAL: Back this up. Losing it means all stored tokens are unrecoverable.
ENCRYPTION_KEY=

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=sk_live_...

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# https://sentry.io → New Project → Node.js → DSN
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production
