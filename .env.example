###############################################################################
# .env.example — Plantilla de variables de entorno
# Copiar a `.env` (en la raíz para vars compartidas) y a `apps/*/env`.
# NUNCA commitear el .env real. Está en .gitignore.
###############################################################################

# ----- General -----
NODE_ENV=development
LOG_LEVEL=debug

# URLs (en dev, locales; en prod, dominios reales)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000

# ----- Database -----
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public

# Runtime (NestJS app): usuario sin superuser ni bypassrls — sujeto a RLS.
DATABASE_URL=postgresql://app_user:password@localhost:5432/legal_saas_dev?schema=public

# Admin (Prisma CLI): usuario con privilegios DDL para migrations.
# Prisma CLI (migrate dev/deploy/status) usa esta URL; Prisma Client usa DATABASE_URL.
DATABASE_URL_DIRECT=postgresql://legal_saas:password@localhost:5432/legal_saas_dev?schema=public

# Solo para jobs de mantenimiento cross-tenant con audit obligatorio.
DATABASE_URL_BYPASS_RLS=postgresql://bypass_rls:password@localhost:5432/legal_saas_dev?schema=public

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- Cifrado de tokens (AES-256-GCM) -----
# En dev, generar una clave aleatoria de 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# En prod, esto vive en KMS y se rota trimestralmente.
ENCRYPTION_KEY=

# ----- Meta (Facebook + Instagram) -----
# Crear app en https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
# Token arbitrario que tú eliges. Lo configurarás en el Webhook Setup de Meta.
# Generar uno fuerte: openssl rand -hex 32
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# URL pública (con HTTPS) que recibe webhooks. En dev usar ngrok/cloudflared.
META_WEBHOOK_URL=https://your-tunnel.ngrok.app/webhooks/meta

# ----- Anthropic (LLM principal) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CLASSIFIER=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_REASONING=claude-sonnet-4-5

# ----- OpenAI (fallback + embeddings) -----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ----- Auth (Clerk) -----
# Crear proyecto en https://clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Para Next.js (web)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ----- Pagos (Stripe) -----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Solo en web (público)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----- MercadoPago (secundario, MX) -----
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# ----- Observability -----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=

POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ----- Email transaccional (Resend) -----
RESEND_API_KEY=
EMAIL_FROM="Legal SaaS <noreply@yourdomain.com>"

# ----- Storage (S3 o R2) -----
S3_ENDPOINT=
S3_BUCKET=legal-saas-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ----- Feature flags / config de runtime -----
ENABLE_AUTO_REPLY=true
INTENT_SCORE_THRESHOLD=0.7
META_RATE_LIMIT_THRESHOLD=75
DM_SEND_CONCURRENCY=5
CLASSIFY_CONCURRENCY=10

# ----- Seguridad -----
# Para CSRF tokens, JWT signing, etc. en NestJS si Clerk no los gestiona todos.
APP_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

###############################################################################
# Reglas
# 1. Si agregas una variable nueva, agrégala también en `turbo.json > globalEnv`.
# 2. Si la variable es pública (frontend), prefijo `NEXT_PUBLIC_`.
# 3. En CI, las vars se inyectan desde GitHub Actions Secrets (NUNCA hardcoded).
# 4. Rotación trimestral obligatoria de: ENCRYPTION_KEY, META_VERIFY_TOKEN,
#    APP_JWT_SECRET, todas las _API_KEY de servicios externos.
###############################################################################
